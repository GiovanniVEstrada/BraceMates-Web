---
/**
 * Fixed bottom bar on mobile (<768px). Hidden on desktop.
 * Links to /contact; on /contact itself (no form there) it becomes a plain call link.
 * global.css adds matching padding-bottom to <body>.
 */
import Button from './Button.astro';
import { telHref } from '../data/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const onContact = path === '/contact';
const href = onContact ? telHref() : '/contact';
const label = onContact ? 'Call' : 'Book a free call';
---

<div class="sticky-cta">
  <Button href={href} block icon="phone" iconPosition="start" class="sticky-cta__btn">{label}</Button>
</div>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 10;
    padding: 12px 16px calc(16px + env(safe-area-inset-bottom, 0px));
    background: var(--sticky-bg);
    border-top: 1px solid var(--border);
    box-shadow: var(--shadow-sticky);
  }
  .sticky-cta :global(.sticky-cta__btn) {
    min-height: 54px;
    padding: 12px 24px;
    gap: 10px;
  }
  @media (prefers-reduced-motion: no-preference) {
    /* [sticky-vt] Keep the bar fixed across page transitions */
    .sticky-cta {
      view-transition-name: sticky-cta;
    }
  }
  @media (min-width: 768px) {
    .sticky-cta {
      display: none;
    }
  }
</style>

---
/**
 * Pill button/link.
 * - variant "primary": copper, espresso text 19px/700 (the only copper fill).
 * - variant "secondary": transparent, 1.5px OD-green border and text (on light backgrounds).
 * - variant "outline-dark": outlined pill with linen-light text (on walnut/espresso).
 * Renders <a> when `href` is set, otherwise <button> (default type "button").
 * `icon`: primary defaults to a trailing "arrow-right"; others default to none.
 * Use icon="phone" iconPosition="start" for the phone-led style. icon={false} removes it.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline-dark';
  /** primary: md = 56px, lg = 58px (hero/CTA band). secondary: md = 48px, sm = 46px. */
  size?: 'sm' | 'md' | 'lg';
  /** Full width. */
  block?: boolean;
  /** Full width on mobile (<=767px) only; auto width on desktop. */
  blockMobile?: boolean;
  icon?: IconName | false;
  iconPosition?: 'start' | 'end';
  type?: 'button' | 'submit' | 'reset';
  class?: string;
  [attr: string]: unknown;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  block = false,
  blockMobile = false,
  icon,
  iconPosition = 'end',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const resolvedIcon: IconName | false = icon === undefined ? (variant === 'primary' ? 'arrow-right' : false) : icon;
const iconSize = variant === 'primary' ? 20 : 18;
const iconStroke = resolvedIcon === 'arrow-right' ? 2.25 : 2;
const classes = ['btn', `btn--${variant}`, `btn--${size}`, { 'btn--block': block, 'btn--block-mobile': blockMobile }, className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      {resolvedIcon && iconPosition === 'start' && <Icon name={resolvedIcon} size={iconSize} strokeWidth={iconStroke} />}
      <span>
        <slot />
      </span>
      {resolvedIcon && iconPosition === 'end' && <Icon name={resolvedIcon} size={iconSize} strokeWidth={iconStroke} />}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {resolvedIcon && iconPosition === 'start' && <Icon name={resolvedIcon} size={iconSize} strokeWidth={iconStroke} />}
      <span>
        <slot />
      </span>
      {resolvedIcon && iconPosition === 'end' && <Icon name={resolvedIcon} size={iconSize} strokeWidth={iconStroke} />}
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    border: 0;
    border-radius: var(--radius-pill);
    font-family: inherit;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
  }
  .btn--block {
    display: flex;
    width: 100%;
  }

  /* Primary: copper pill, espresso text. Never light text on copper. */
  .btn--primary {
    min-height: 56px;
    padding: 16px 28px;
    background: var(--copper);
    color: var(--espresso);
    font-size: 19px;
  }
  .btn--primary.btn--lg {
    min-height: 58px;
    padding: 16px 30px;
  }
  .btn--primary.btn--sm {
    min-height: 54px;
    padding: 12px 22px;
  }
  /* blockMobile: full width on mobile only */
  @media (max-width: 767.98px) {
    .btn--block-mobile {
      display: flex;
      width: 100%;
      gap: 10px;
    }
    .btn--primary.btn--block-mobile {
      min-height: 56px;
      padding: 14px 24px;
    }
  }
  .btn--primary:hover {
    color: var(--espresso);
    filter: brightness(1.06);
  }

  /* Secondary: OD-green outline */
  .btn--secondary {
    min-height: 48px;
    padding: 12px 22px;
    border: 1.5px solid var(--od-green);
    background: transparent;
    color: var(--od-green);
    font-size: 16px;
    gap: 10px;
  }
  .btn--secondary.btn--sm {
    min-height: 46px;
    padding: 10px 18px;
    font-size: 15px;
  }
  .btn--secondary.btn--lg {
    min-height: 54px;
    font-size: 17px;
  }
  .btn--secondary:hover {
    color: var(--walnut);
    border-color: var(--walnut);
  }

  /* Outline on dark: header call pill */
  .btn--outline-dark {
    min-height: 44px;
    padding: 10px 18px;
    border: 1.5px solid var(--border-on-dark-strong);
    background: transparent;
    color: var(--linen-light);
    font-size: 16px;
    gap: 10px;
  }
  .btn--outline-dark.btn--lg {
    min-height: 52px;
    font-size: 17px;
  }
  .btn--outline-dark:hover {
    color: var(--linen-light);
    background: var(--nav-pill-bg);
  }
</style>

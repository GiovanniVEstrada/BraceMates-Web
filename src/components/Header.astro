---
/**
 * Site header. Current page is detected from the URL (aria-current="page").
 * Desktop: wordmark and nav only (no call pill; owner decision).
 * Mobile: wordmark, 44px envelope-icon button (links to /contact), 44px menu button; menu panel opens below the bar.
 */
import { nav, site, telHref } from '../data/site';
import Wordmark from './Wordmark.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';

// Pages are built as about.html etc. (build.format: 'file'), so strip ".html" to compare against nav hrefs.
const path = Astro.url.pathname.replace(/(index)?\.html$/, '').replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <Wordmark size="header" />

    <nav id="site-nav" class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={item.href} class="site-nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <Button
        href={telHref()}
        variant="outline-dark"
        size="lg"
        icon={false}
        class="site-nav__call"
      >
        Call {site.phone}
      </Button>
    </nav>

    <div class="site-header__actions">
      <a href="/contact" class="icon-btn site-header__call-mobile" aria-label="Contact">
        <Icon name="mail" size={22} />
      </a>
      <button
        type="button"
        class="icon-btn site-header__menu"
        aria-expanded="false"
        aria-controls="site-nav"
        aria-label="Open menu"
        data-menu-button
      >
        <span class="icon-open"><Icon name="menu" size={24} /></span>
        <span class="icon-close"><Icon name="x" size={24} /></span>
      </button>
    </div>
  </div>
</header>
<div class="menu-backdrop" data-menu-backdrop aria-hidden="true"></div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--walnut);
    color: var(--linen);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 12px;
    min-height: 64px;
    padding: 8px 10px 8px 20px;
  }
  .site-header__actions {
    order: 2;
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--linen-light);
  }
  .icon-btn:hover {
    color: var(--linen-light);
    background: var(--nav-pill-bg);
  }
  .icon-close {
    display: none;
  }
  .site-header__menu[aria-expanded='true'] .icon-open {
    display: none;
  }
  .site-header__menu[aria-expanded='true'] .icon-close {
    display: block;
  }

  /* Mobile menu panel. It overlays the page just below the header bar (position: absolute), so opening it
     never changes the page layout; otherwise scroll anchoring would shift the scroll position and the
     close-on-scroll rule would shut the menu as soon as it opened. Closed = collapsed and hidden
     (visibility keeps its links out of the tab order); open = expanded. Both directions animate under
     [menu-ease] below. */
  .site-nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    max-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    /* Scrolling inside a tall menu must not scroll the page behind it (which would close the menu). */
    overscroll-behavior: contain;
    padding: 0 12px;
    background: var(--walnut);
    border-top: 1px solid transparent;
    opacity: 0;
    visibility: hidden;
  }
  .site-header.is-open .site-nav {
    /* a little taller than the menu (~390px) so the close does not pause at the start;
       never taller than the space under the header on short phones (the menu then scrolls inside itself) */
    max-height: min(480px, calc(100dvh - 64px));
    padding: 8px 12px 20px;
    border-top-color: var(--nav-divider);
    opacity: 1;
    visibility: visible;
  }

  /* Dimmed page behind the open menu; tapping it closes the menu. Sits below the header (z-index 50). */
  .menu-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: var(--menu-backdrop);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .site-header.is-open + .menu-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .site-nav__link {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: 0 12px;
    border-radius: var(--radius-input);
    color: var(--linen);
    font-size: 18px;
    font-weight: 600;
    text-decoration: none;
  }
  .site-nav__link:hover {
    color: var(--linen-light);
    background: var(--nav-pill-bg);
  }
  .site-nav__link[aria-current='page'] {
    background: var(--nav-pill-bg);
    color: var(--linen-light);
    font-weight: 700;
  }
  .site-nav :global(.site-nav__call) {
    margin-top: 10px;
    width: 100%;
    min-height: 52px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .icon-btn,
    .site-nav__link {
      transition:
        color var(--dur-fast) var(--ease),
        background-color var(--dur-fast) var(--ease);
    }
    /* [menu-ease] Mobile menu panel and backdrop ease open and closed. `visibility` flips after the
       close animation finishes (delayed on close, immediate on open). */
    @media (max-width: 767.98px) {
      .site-nav {
        transition:
          max-height 300ms var(--ease),
          padding 300ms var(--ease),
          opacity 200ms var(--ease),
          border-color 300ms var(--ease),
          visibility 0s linear 300ms;
      }
      .site-header.is-open .site-nav {
        transition:
          max-height 300ms var(--ease),
          padding 300ms var(--ease),
          opacity 250ms var(--ease) 50ms,
          border-color 300ms var(--ease),
          visibility 0s;
      }
      .menu-backdrop {
        transition:
          opacity 250ms var(--ease),
          visibility 0s linear 250ms;
      }
      .site-header.is-open + .menu-backdrop {
        transition:
          opacity 250ms var(--ease),
          visibility 0s;
      }
    }
  }

  @media (min-width: 768px) {
    .site-header__inner {
      max-width: var(--container-wide);
      margin-inline: auto;
      gap: 12px 32px;
      padding: 16px var(--gutter);
    }
    /* Phone-only buttons (contact icon, menu toggle) and the menu's call pill are hidden on desktop. */
    .site-header__actions,
    .site-nav :global(.site-nav__call) {
      display: none;
    }
    .menu-backdrop {
      display: none;
    }
    .site-nav {
      order: 2;
      position: static;
      display: flex;
      flex-direction: row;
      flex-basis: auto;
      flex-wrap: wrap;
      align-items: center;
      gap: 4px;
      margin: 0;
      padding: 0;
      border-top: 0;
      background: transparent;
      /* Undo the mobile collapsed state: the desktop nav is always visible. */
      max-height: none;
      overflow: visible;
      opacity: 1;
      visibility: visible;
    }
    .site-nav__link {
      min-height: 44px;
      padding: 10px 14px;
      border-radius: var(--radius-pill);
      font-size: 16px;
      font-weight: 500;
    }
    .site-nav__link[aria-current='page'] {
      font-weight: 600;
    }
    /* Desktop: hover/focus shows a sliding underline instead of the hover pill (current page keeps its pill) */
    .site-nav__link {
      position: relative;
    }
    .site-nav__link:not([aria-current='page']):hover {
      background: transparent;
    }
    .site-nav__link:not([aria-current='page'])::after {
      content: '';
      position: absolute;
      left: 14px;
      right: 14px;
      bottom: 8px;
      height: 2px;
      border-radius: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left;
    }
    .site-nav__link:not([aria-current='page']):focus-visible::after {
      transform: scaleX(1);
    }
    @media (hover: hover) {
      .site-nav__link:not([aria-current='page']):hover::after {
        transform: scaleX(1);
      }
    }
    @media (prefers-reduced-motion: no-preference) {
      .site-nav__link::after {
        transition: transform var(--dur) var(--ease);
      }
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const button = header?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const nav = header?.querySelector<HTMLElement>('#site-nav');
  const backdrop = document.querySelector<HTMLElement>('[data-menu-backdrop]');

  if (header && button && nav) {
    let openedAtY = 0;
    let openedAt = 0;
    const setOpen = (open: boolean) => {
      if (open) {
        openedAtY = window.scrollY;
        openedAt = performance.now();
      }
      header.classList.toggle('is-open', open);
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

    // Close when the dimmed page behind the menu is tapped
    backdrop?.addEventListener('click', () => setOpen(false));

    // Close when the page starts scrolling. A small threshold ignores finger jitter, and scroll events in
    // the first 400ms after opening (layout settling, mobile browser toolbars resizing) are ignored.
    window.addEventListener(
      'scroll',
      () => {
        if (!header.classList.contains('is-open') || performance.now() - openedAt < 400) return;
        if (Math.abs(window.scrollY - openedAtY) > 24) setOpen(false);
      },
      { passive: true },
    );

    // Close on link click
    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) setOpen(false);
    });

    // Close on Escape and return focus to the menu button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });

    // Reset when the viewport grows to desktop
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>

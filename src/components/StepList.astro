---
/**
 * Numbered steps ("How it works"): leather numerals with a 2px walnut top rule.
 * Defaults to the Home steps from src/data/site.ts (`howItWorks.steps`).
 */
import { howItWorks } from '../data/site';

interface Step {
  title: string;
  body: string;
}
interface Props {
  steps?: readonly Step[];
}
const { steps = howItWorks.steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((step, i) => (
      <li class="step">
        <span class="step__num" aria-hidden="true">{i + 1}</span>
        <h3 class="step__title">{step.title}</h3>
        <p>{step.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 40px 56px;
  }
  .step {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
    border-top: 2px solid var(--walnut);
  }
  .step__num {
    font-family: var(--font-display);
    font-size: 72px;
    font-weight: 800;
    line-height: 1;
    color: var(--leather);
  }
  .step__title {
    font-size: 26px;
    line-height: 1.2;
  }

  /* Mobile (HomeMobile): numeral column beside title and text, no top rule */
  @media (max-width: 767.98px) {
    .steps {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }
    .step {
      display: grid;
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 4px 16px;
      align-items: start;
      padding-top: 0;
      border-top: 0;
    }
    .step__num {
      grid-row: span 2;
      font-size: 52px;
      line-height: 0.95;
    }
    .step__title {
      font-size: 22px;
      line-height: 1.25;
    }
    .step p {
      font-size: 16px;
    }
  }
</style>

---
/**
 * Text wordmark until the real logo arrives. Swap the contents here to replace it everywhere.
 * `size`: 'header' (28px desktop / 23px mobile), 'footer' (26px desktop / 24px mobile).
 * Renders a link home. Set `link={false}` to render a plain block.
 */
import { site } from '../data/site';

interface Props {
  size?: 'header' | 'footer';
  link?: boolean;
  class?: string;
}

const { size = 'header', link = true, class: className } = Astro.props;
const Tag = link ? 'a' : 'span';
---

<Tag
  class:list={['wordmark', `wordmark--${size}`, className]}
  href={link ? '/' : undefined}
  aria-label={link ? `${site.name}, home` : undefined}
>
  <span class="wordmark__name" aria-hidden={link ? 'true' : undefined}>{site.shortName}</span>
  <span class="wordmark__sub" aria-hidden={link ? 'true' : undefined}>{site.wordmarkSub}</span>
</Tag>

<style>
  .wordmark {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 6px 0;
    text-decoration: none;
    color: var(--linen-light);
  }
  .wordmark:hover {
    color: var(--linen-light);
  }
  .wordmark__name {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .wordmark__sub {
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
  .wordmark--footer {
    align-self: flex-start;
  }
  .wordmark--footer .wordmark__name {
    font-size: 24px;
  }
  @media (min-width: 768px) {
    .wordmark {
      gap: 5px;
      padding: 4px 0;
    }
    .wordmark__name {
      font-size: 28px;
    }
    .wordmark__sub {
      font-size: 11px;
    }
    .wordmark--footer .wordmark__name {
      font-size: 26px;
    }
  }
</style>

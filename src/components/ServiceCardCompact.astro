---
/**
 * Home services-preview card: OD-green card, linen-light text.
 * Pass a `Service` from src/data/services.ts. Uses service.homeTag, name, summary, price.
 */
import type { Service } from '../data/services';

interface Props {
  service: Service;
  /** Link target for "Details". */
  href?: string;
}
const { service, href = '/services' } = Astro.props;
---

<article class="card" data-reveal>
  <p class="card__tag">{service.homeTag}</p>
  <h3 class="card__name">{service.name}</h3>
  <p class="card__summary">{service.summary}</p>
  <div class="card__foot">
    <p class="card__price">Starting at<strong>{service.price}</strong></p>
    <a class="card__link" href={href}>Details<span class="sr-only"> on {service.name}</span></a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 340px;
    padding: 28px;
    border-radius: var(--radius-card);
    background: var(--od-green);
    color: var(--linen-light);
  }
  .card__tag {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    background: var(--tag-on-green);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
  }
  .card__name {
    font-size: 24px;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: inherit;
  }
  .card__summary {
    font-size: 16px;
    line-height: 1.55;
  }
  .card__foot {
    margin-top: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-top: 16px;
    border-top: 1px solid var(--on-green-divider);
  }
  .card__price {
    display: flex;
    flex-direction: column;
    font-size: 13px;
    line-height: 1.35;
  }
  .card__price strong {
    font-size: 20px;
    font-weight: 700;
  }
  .card__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--linen-light);
    font-size: 15px;
    font-weight: 700;
    text-underline-offset: 4px;
  }
  .card__link:hover {
    color: var(--linen-light);
  }

  /* Motion: hover lift on hover-capable devices only */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
    @media (hover: hover) {
      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-card-hover);
      }
    }
  }

  /* Mobile (HomeMobile): compact card, inline price */
  @media (max-width: 767.98px) {
    .card {
      gap: 10px;
      min-height: 0;
      padding: 22px;
      border-radius: 18px;
    }
    .card__tag {
      padding: 4px 11px;
      font-size: 12px;
    }
    .card__name {
      font-size: 22px;
      letter-spacing: 0;
    }
    .card__summary {
      line-height: 1.5;
    }
    .card__foot {
      align-items: center;
      margin-top: 4px;
      padding-top: 12px;
    }
    .card__price {
      flex-direction: row;
      align-items: baseline;
      gap: 0.3em;
      font-size: 14px;
    }
    .card__price strong {
      font-size: 18px;
    }
  }
</style>

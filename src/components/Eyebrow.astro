---
/** Small uppercase label above headings. 13px/0.2em desktop, 12px/0.18em mobile. */
interface Props {
  /** Use on dark backgrounds (walnut, espresso, hero). */
  onDark?: boolean;
  class?: string;
}
const { onDark = false, class: className } = Astro.props;
---

<p class:list={['eyebrow', { 'eyebrow--dark': onDark }, className]}><slot /></p>

<style>
  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--leather);
  }
  .eyebrow--dark {
    color: var(--on-dark-muted);
  }
  @media (min-width: 768px) {
    .eyebrow {
      font-size: 13px;
      letter-spacing: 0.2em;
    }
  }
</style>

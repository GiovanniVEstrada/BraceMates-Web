---
/**
 * Full Services-page card: tag pill, name, description, "What's included" checklist,
 * price block and "Ask about this" outline button. Pass a `Service` from src/data/services.ts.
 */
import type { Service } from '../data/services';
import Button from './Button.astro';
import Icon from './Icon.astro';

interface Props {
  service: Service;
  /** Where "Ask about this" goes. */
  href?: string;
}
const { service, href = '/contact' } = Astro.props;
const headingId = `svc-${service.slug}`;
---

<article class="card" aria-labelledby={headingId} data-reveal>
  <p class="card__tag">{service.tag}</p>
  <h2 id={headingId} class="card__name">{service.name}</h2>
  <p class="card__desc">{service.description}</p>
  <h3 class="card__incl">What’s included</h3>
  <ul class="card__list">
    {
      service.included.map((item) => (
        <li>
          <Icon name="check" size={18} strokeWidth={2.5} />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
  <div class="card__foot">
    <p class="card__price">
      <span class="card__price-label">Starting at</span>
      <strong>{service.price}</strong>
      <span class="card__price-label">{service.priceNote}</span>
    </p>
    <Button href={href} variant="secondary" size="sm" aria-label={`Ask about ${service.name}`}>Ask about this</Button>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--linen-light);
  }
  .card__tag {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--od-green);
    color: var(--linen-light);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
  }
  .card__name {
    font-size: 26px;
    line-height: 1.12;
    letter-spacing: -0.01em;
  }
  .card__desc {
    font-size: 16px;
  }
  .card__incl {
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .card__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 16px;
    line-height: 1.45;
    color: var(--espresso);
  }
  .card__list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
  }
  .card__list :global(.icon) {
    margin-top: 2px;
    color: var(--od-green);
  }
  .card__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .card__price {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .card__price-label {
    font-size: 13px;
    color: var(--text-muted);
  }
  .card__price strong {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 800;
    color: var(--walnut);
  }

  /* Motion: hover lift on hover-capable devices only */
  @media (prefers-reduced-motion: no-preference) {
    .card {
      transition:
        transform var(--dur) var(--ease),
        box-shadow var(--dur) var(--ease);
    }
    @media (hover: hover) {
      .card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-card-hover);
      }
    }
  }
</style>

---
/**
 * Page shell: <head>, fonts, skip link, Header, <main>, Footer, StickyCTA.
 * SEO extras (Open Graph, JSON-LD, favicon) go in <slot name="head" /> or are added here by the SEO step.
 * Pages put their content in the default slot; it is rendered inside <main id="main">.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import bricolageFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import figtreeFont from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { site, isPlaceholder, realSocials, allowIndexing } from '../data/site';

interface Props {
  /** Full <title>. */
  title: string;
  /** Meta description (draft from page copy). */
  description: string;
  /** Hide from search engines (e.g. /thanks). */
  noindex?: boolean;
  /** Hide the sticky mobile CTA. */
  hideStickyCTA?: boolean;
}

const { title, description, noindex: pageNoindex = false, hideStickyCTA = false } = Astro.props;
const noindex = pageNoindex || !allowIndexing;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL('/og-image.jpg', Astro.site ?? site.url).href;

// LocalBusiness JSON-LD: only fields that are real (not bracketed placeholders) are output.
const areas = [site.city, ...site.serviceArea.towns].filter((a) => !isPlaceholder(a));
const sameAs = realSocials().map((s) => s.url);
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.name,
  url: site.url,
  ...(isPlaceholder(site.phone) ? {} : { telephone: site.phone }),
  ...(isPlaceholder(site.email) ? {} : { email: site.email }),
  ...(areas.length ? { areaServed: [...new Set(areas)] } : {}),
  ...(sameAs.length ? { sameAs } : {}),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={bricolageFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={figtreeFont} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
    {!hideStickyCTA && <StickyCTA />}
  </body>
</html>

<style is:global>
  .page {
    background: var(--linen);
  }
</style>

---
/**
 * Page shell: <head>, fonts, skip link, Header, <main>, Footer, StickyCTA.
 * SEO extras (Open Graph, JSON-LD, favicon) go in <slot name="head" /> or are added here by the SEO step.
 * Pages put their content in the default slot; it is rendered inside <main id="main">.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCTA from '../components/StickyCTA.astro';
import { site } from '../data/site';

interface Props {
  /** Full <title>. */
  title: string;
  /** Meta description (draft from page copy). */
  description: string;
  /** Hide from search engines (e.g. /thanks). */
  noindex?: boolean;
  /** Hide the sticky mobile CTA. */
  hideStickyCTA?: boolean;
}

const { title, description, noindex = false, hideStickyCTA = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="generator" content={Astro.generator} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="page">
      <Header />
      <main id="main">
        <slot />
      </main>
    </div>
    <Footer />
    {!hideStickyCTA && <StickyCTA />}
  </body>
</html>

<style is:global>
  .page {
    background: var(--linen);
  }
</style>

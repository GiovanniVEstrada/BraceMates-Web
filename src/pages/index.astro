---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/photo-11-dog-golden-dust.png';
import ServiceCardCompact from '../components/ServiceCardCompact.astro';
import StepList from '../components/StepList.astro';
import Testimonial from '../components/Testimonial.astro';
import CTABand from '../components/CTABand.astro';
import { site, telHref, howItWorks, testimonialPlaceholders } from '../data/site';
import { services, servicesCopy } from '../data/services';
---

<BaseLayout
  title={`Dog Training in ${site.city} | Brace Mates Dog Training`}
  description={`Dog training in ${site.city}. Puppy training, basic obedience, and started or broke gun dog and retriever training. Book a free phone consultation.`}
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-title">
    <Image
      class="hero__img"
      src={heroPhoto}
      alt=""
      widths={[640, 960, 1394]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="hero__inner container-wide">
      <Eyebrow onDark>
        <span class="desk">Training for you and your dog, together</span>
        <span class="mob">Training for you and your dog</span>
      </Eyebrow>
      <h1 id="hero-title" class="hero-title hero__title">Dog training in {site.city}</h1>
      <p class="hero__sub">
        <span class="desk">Puppy training, everyday obedience and hunting dog training — with a plan that fits you and your dog.</span>
        <span class="mob">Puppy training, everyday obedience and hunting dog training for you and your dog.</span>
      </p>
      <div class="hero__actions">
        <Button href="/contact" size="lg">Book a free consultation</Button>
        <a class="hero__call" href={telHref()}>or call {site.phone}</a>
      </div>
    </div>
  </section>

  <!-- Problems -->
  <section class="problems" aria-labelledby="problems-title">
    <div class="container problems__grid" data-reveal>
      <div class="stack-head">
        <Eyebrow>Sound familiar?</Eyebrow>
        <h2 id="problems-title">Most “problem dogs” just haven’t been shown another way yet.</h2>
      </div>
      <div class="problems__copy">
        <p>Every walk turns into a tug-of-war. Your dog jumps on every guest, ignores you when you call, or treats your hands like chew toys. Maybe you have a new bird dog and aren’t sure where to start.</p>
        <p>None of that makes them a bad dog — or you a bad owner. These are some of the most common things I help with, and they can all get better with the right plan and steady practice.</p>
      </div>
    </div>
  </section>

  <!-- Services preview -->
  <section class="services" aria-labelledby="services-title">
    <div class="container services__wrap">
      <div class="services__head" data-reveal>
        <div class="stack-head services__intro">
          <Eyebrow>{servicesCopy.homePreview.eyebrow}</Eyebrow>
          <h2 id="services-title">{servicesCopy.homePreview.title}</h2>
          <p>{servicesCopy.homePreview.intro}</p>
        </div>
        <Button href="/services" variant="secondary" icon="arrow-right" class="services__all--desk">See all services</Button>
      </div>
      <div class="cards">
        {services.map((service) => <ServiceCardCompact service={service} />)}
      </div>
      <Button href="/services" variant="secondary" size="lg" icon="arrow-right" blockMobile class="services__all--mob">See all services</Button>
    </div>
  </section>

  <!-- How it works -->
  <section class="how band-dark" aria-labelledby="how-title">
    <div class="container how__wrap">
      <div class="stack-head how__head" data-reveal>
        <Eyebrow>{howItWorks.eyebrow}</Eyebrow>
        <h2 id="how-title">{howItWorks.title}</h2>
      </div>
      <StepList />
      <div class="how__cta">
        <Button href="/contact" blockMobile>Book a free consultation</Button>
      </div>
    </div>
  </section>

  <!-- Testimonials (placeholders only) -->
  <section class="reviews" aria-labelledby="reviews-title">
    <div class="container reviews__wrap">
      <div class="reviews__head" data-reveal>
        <div class="stack-head">
          <Eyebrow>Kind words</Eyebrow>
          <h2 id="reviews-title">What dog owners say</h2>
        </div>
        <p class="reviews__note">
          <span class="desk">Placeholder testimonials — swap in real client reviews before launch</span>
          <span class="mob">Placeholders — swap in real reviews</span>
        </p>
      </div>
      <div class="reviews__list" role="region" aria-label="Testimonials" tabindex="0">
        {testimonialPlaceholders.map((t) => <Testimonial quote={t.quote} name={t.name} location={t.location} placeholder />)}
      </div>
      <p class="reviews__swipe">Swipe for more</p>
    </div>
  </section>

  <!-- Final CTA -->
  <CTABand tone="walnut" title="Ready for calmer walks and easier days?">
    Book a free consultation. We’ll talk through what’s going on and what training could look like — no pressure, no obligation.
  </CTABand>
</BaseLayout>

<style>
  .desk {
    display: none;
  }
  .stack-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* ---------- Hero (mobile first) ---------- */
  .hero {
    position: relative;
    min-height: 600px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--hero-overlay);
  }
  .hero__inner {
    position: relative;
    padding: 52px 20px 100px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
  }
  .hero__sub {
    font-size: 18px;
    line-height: 1.55;
    color: var(--linen);
  }
  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin-top: 8px;
  }
  .hero__call {
    align-self: center;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 8px;
    color: var(--linen-light);
    font-size: 16px;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .hero__call:hover {
    color: var(--linen-light);
  }

  /* ---------- Problems ---------- */
  .problems {
    padding: 56px 20px;
  }
  .problems__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }
  .problems .stack-head {
    gap: 16px;
  }
  .problems__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ---------- Services ---------- */
  .services {
    padding: 0 20px 64px;
  }
  .services__wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .services__head {
    padding-top: 48px;
    border-top: 1px solid var(--border-section);
  }
  .cards {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .services__all--desk {
    display: none;
  }

  /* ---------- How it works ---------- */
  .how {
    padding: 64px 20px;
  }
  .how__wrap {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .how__cta {
    display: flex;
    flex-direction: column;
  }
  /* ---------- Reviews: horizontal scroll-snap on mobile ---------- */
  .reviews {
    padding: 64px 0;
  }
  .reviews__wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .reviews__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 20px;
  }
  .reviews__note {
    align-self: flex-start;
    margin-top: 4px;
    padding: 6px 14px;
    border: 1.5px dashed var(--leather);
    border-radius: var(--radius-pill);
    color: var(--leather);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.4;
  }
  .reviews__list {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 4px 20px 8px;
    scroll-padding-left: 20px;
  }
  .reviews__swipe {
    padding: 0 20px;
    font-size: 14px;
    color: var(--text-muted);
  }

  /* ---------- Motion ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* [hero-intro] Text block fades up in sequence. The h1 animates transform only, so it is
       always visible and LCP is not delayed. The photo is never faded: it only settles (scale). */
    .hero__inner > :global(*) {
      animation: hero-up 600ms var(--ease) both;
    }
    .hero__inner > :global(:nth-child(1)) {
      animation-delay: 0ms;
    }
    .hero__inner > :global(:nth-child(2)) {
      animation-name: hero-rise;
      animation-delay: 80ms;
    }
    .hero__inner > :global(:nth-child(3)) {
      animation-delay: 160ms;
    }
    .hero__inner > :global(:nth-child(4)) {
      animation-delay: 240ms;
    }
    .hero__img {
      animation: hero-settle 1400ms var(--ease) both;
    }
    .hero__call {
      transition: opacity var(--dur-fast) var(--ease);
    }
    @media (hover: hover) {
      .hero__call:hover {
        opacity: 0.85;
      }
    }
  }
  @keyframes hero-up {
    from {
      opacity: 0.01;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(16px);
    }
    to {
      transform: translateY(0);
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.05);
    }
    to {
      transform: scale(1);
    }
  }

  /* ---------- Desktop ---------- */
  @media (min-width: 768px) {
    .desk {
      display: inline;
    }
    .mob {
      display: none;
    }

    .hero {
      min-height: 680px;
    }
    .hero__inner {
      padding: 96px var(--gutter) 128px;
      align-items: flex-start;
      gap: 24px;
    }
    .hero__title {
      max-width: 16ch;
    }
    .hero__sub {
      max-width: 36em;
      font-size: 20px;
    }
    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 28px;
    }
    .hero__call {
      align-self: auto;
      padding: 0;
      font-size: 17px;
    }

    .problems {
      padding: 96px var(--gutter);
    }
    .problems__grid {
      grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
      gap: 28px 80px;
    }
    .problems .stack-head {
      gap: 14px;
    }
    .problems__copy {
      gap: 18px;
      padding-top: 8px;
    }

    .services {
      padding: 0 var(--gutter) 104px;
    }
    .services__wrap {
      gap: 40px;
    }
    .services__head {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px 40px;
      padding-top: 72px;
    }
    .services__intro {
      gap: 14px;
      max-width: 640px;
    }
    .cards {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(250px, 100%), 1fr));
      gap: 20px;
    }
    .services__all--desk {
      display: inline-flex;
    }
    .services__all--mob {
      display: none;
    }

    .how {
      padding: 104px var(--gutter);
    }
    .how__wrap {
      gap: 52px;
    }
    .how__head {
      gap: 14px;
      max-width: 640px;
    }
    .how__cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px 24px;
    }
    .reviews {
      padding: 104px var(--gutter);
    }
    .reviews__wrap {
      gap: 44px;
    }
    .reviews__head {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px 40px;
      padding: 0;
    }
    .reviews__head .stack-head {
      gap: 14px;
    }
    .reviews__note {
      align-self: auto;
      margin-top: 0;
      padding: 8px 16px;
      font-size: 14px;
    }
    .reviews__list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
      gap: 24px;
      overflow: visible;
      padding: 0;
    }
    .reviews__swipe {
      display: none;
    }
  }
</style>

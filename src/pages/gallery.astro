---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';

// Tile order, spans and tones are verbatim from reference/Gallery.dc.html.
// Tiles with a `photo` render an astro:assets <Image> (lazy, object-fit: cover, `pos` = object-position).
// Tiles without one keep the PhotoPlaceholder and its reference label. To swap in the last photo,
// import the file above, then add `photo`, `alt` and `pos` to that tile.
import photo1 from '../assets/images/photo-1-brown-dog-portrait.png';
import photo2 from '../assets/images/photo-2-spotted-dog-brush.png';
import photo3 from '../assets/images/photo-3-brown-dog-profile.png';
import photo4 from '../assets/images/photo-4-dog-pheasant-portrait.png';
import photo5 from '../assets/images/photo-5-man-and-dog-field.png';
import photo7 from '../assets/images/photo-7-three-dogs-forest-road.png';
import photo8 from '../assets/images/photo-8-man-three-dogs-steps.png';
import photo9 from '../assets/images/photo-9-five-dogs-forest-road.png';
import photo10 from '../assets/images/photo-10-five-dogs-cabin-steps.png';
import photo11 from '../assets/images/photo-11-dog-golden-dust.png';
import photo12 from '../assets/images/photo-12-dog-autumn-leaves.png';

type Tone = 'sage' | 'sand' | 'cream' | 'clay';
type Span = 'big' | 'tall' | 'wide';
const tiles: {
  n: string;
  tone: Tone;
  label: string;
  span?: Span;
  photo?: ImageMetadata;
  alt?: string;
  pos?: string;
}[] = [
  { n: 'Gallery 01', tone: 'sage', label: 'Loose-leash walk down a neighborhood street', span: 'big', photo: photo10, alt: 'Five dogs resting on stone steps in front of a log cabin in autumn.', pos: '50% 50%' },
  { n: '02', tone: 'cream', label: 'Puppy learning “sit”', photo: photo2, alt: 'A liver-and-white spotted dog walking through low brush and looking at the camera.', pos: 'center 30%' },
  { n: '03', tone: 'sand', label: 'High-five trick', photo: photo4, alt: 'A brown dog sitting in tall dry grass beside a hunting bag with a pheasant hanging from it.', pos: 'center 30%' },
  { n: '04', tone: 'clay', label: 'Dog settled on a mat at home (tall)', span: 'tall', photo: photo1, alt: 'A chocolate-brown pointer standing mid-step on a dirt path with autumn foliage behind it.', pos: 'center 30%' },
  { n: '05', tone: 'sage', label: 'Treat hand-off, close-up', photo: photo11, alt: 'A dog leaping through a cloud of golden dust against a black background.', pos: 'center 40%' },
  { n: '06', tone: 'sand', label: 'Happy owner and dog', photo: photo5, alt: 'A man kneeling in tall dry grass beside a brown dog sitting at attention.', pos: 'center 35%' },
  { n: '07', tone: 'cream', label: 'Calm walk past another dog — wide shot', span: 'wide', photo: photo9, alt: 'Five dogs sitting and lying in a row on a forest road in autumn.', pos: 'center 50%' },
  { n: '08', tone: 'clay', label: 'Recall at the park', photo: photo3, alt: 'A brown dog standing in profile in golden evening light.', pos: 'center 50%' },
  { n: '09', tone: 'sand', label: 'Puppy portrait (tall)', span: 'tall', photo: photo7, alt: 'Three dogs sitting side by side on a forest road in autumn.', pos: 'center 40%' },
  { n: '10', tone: 'sage', label: 'Polite greeting at the door', photo: photo8, alt: 'A man sitting on stone steps in autumn woods with three dogs.', pos: '50% 40%' },
  { n: '11', tone: 'cream', label: 'Training gear: leash, treat pouch, mat', photo: photo12, alt: 'A brown dog sitting upright among fallen autumn leaves, wearing an orange collar with a bell.', pos: 'center 35%' },
  { n: '12', tone: 'clay', label: 'Resting after a good session' },
];

const wideish = (span?: Span) => span === 'big' || span === 'wide';
const sizesFor = (span?: Span) => (wideish(span) ? '(min-width: 768px) 580px, 100vw' : '(min-width: 768px) 285px, 50vw');
const widthsFor = (span?: Span) => (wideish(span) ? [400, 800, 1200] : [200, 400, 600]);
---

<BaseLayout
  title="Gallery | Brace Mates Dog Training"
  description={`Snapshots from in-home dog training sessions around ${site.city}.`}
>
  <section class="section intro" aria-labelledby="gallery-title">
    <div class="container intro__inner">
      <Eyebrow>Gallery</Eyebrow>
      <h1 id="gallery-title">Good dogs, real progress</h1>
      <p>Snapshots from training sessions around {site.city}.</p>
    </div>
  </section>

  <div class="grid-wrap">
    <ul class="container grid" aria-label="Photo gallery">
      {
        tiles.map((t) => (
          <li class:list={['tile', t.span && `tile--${t.span}`]} data-reveal>
            {t.photo ? (
              <Image
                src={t.photo}
                alt={t.alt ?? ''}
                widths={widthsFor(t.span)}
                sizes={sizesFor(t.span)}
                loading="lazy"
                decoding="async"
                style={`object-position: ${t.pos ?? 'center'}`}
              />
            ) : (
              <PhotoPlaceholder
                tone={t.tone}
                variant={t.span === 'big' ? 'tile' : 'tile-sm'}
                title={t.n}
                caption={t.label}
                label={`Photo placeholder: ${t.label}`}
              />
            )}
          </li>
        ))
      }
    </ul>
  </div>

  <CTABand title="Want your dog in here?" tone="walnut" showCall={false}>
    Every one of these started with a free call. Yours can too.
  </CTABand>
</BaseLayout>

<style>
  .intro {
    padding-top: 48px;
    padding-bottom: 28px;
  }
  .intro__inner {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .grid-wrap {
    padding: 0 var(--gutter) 56px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 160px;
    grid-auto-flow: dense;
    gap: 10px;
  }
  .tile {
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
  }
  .tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 16px;
  }
  .tile--big {
    grid-column: span 2;
    grid-row: span 2;
  }
  .tile--tall {
    grid-row: span 2;
  }
  .tile--wide {
    grid-column: span 2;
  }

  /* Motion: slow image zoom on hover (image is clipped by the tile) */
  @media (prefers-reduced-motion: no-preference) {
    .tile :global(img) {
      transition: transform var(--dur-slow) var(--ease);
    }
    @media (hover: hover) {
      .tile:hover :global(img) {
        transform: scale(1.04);
      }
    }
  }

  @media (min-width: 768px) {
    .intro {
      padding-top: 88px;
      padding-bottom: 48px;
    }
    .grid-wrap {
      padding-bottom: 104px;
    }
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 220px;
      gap: 16px;
    }
  }
</style>

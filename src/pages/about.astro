---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import aboutPhoto from '../assets/images/photo-8-man-three-dogs-steps.png';
import CTABand from '../components/CTABand.astro';
import { site } from '../data/site';

// Page-specific copy, verbatim from reference/About.dc.html.
const principles = [
  {
    title: 'Behavior is communication',
    body: 'Barking, pulling and jumping all mean something. We figure out the why first, so the fix actually sticks.',
  },
  {
    title: 'Every dog is different',
    body: 'A program built to work for every dog wouldn’t work for any of them. I have core ideas and steps, and I adjust them for each dog as training goes.',
  },
  {
    title: 'You’re half the team',
    body: 'I coach you as much as your dog, with skills that fit your real routine — so progress keeps going between visits.',
  },
  {
    title: 'Real life, real places',
    body: 'We train where real life happens: in your home and neighborhood for everyday obedience, and in the field for hunting dogs.',
  },
];
---

<BaseLayout
  title="About Lance | Brace Mates Dog Training"
  description={`Meet Lance, the dog trainer behind Brace Mates. Practical training for puppies, everyday obedience and hunting dogs across ${site.city}.`}
>
  <div class="intro-wrap section">
    <div class="container intro-grid">
      <section class="intro" aria-labelledby="about-title">
        <Eyebrow>About</Eyebrow>
        <h1 id="about-title">Hi, I’m Lance.</h1>
        <p class="lede">
          I help dogs and their people feel calmer, more confident and more connected — one practical step at a time.
        </p>
      </section>

      <div class="portrait">
        <Image
          src={aboutPhoto}
          alt="A man sitting on stone steps in autumn woods with three dogs."
          widths={[480, 720, 896]}
          sizes="(min-width: 768px) 45vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <section class="story" aria-labelledby="story-title">
        <h2 id="story-title">How I got here</h2>
        <p>
          Like most dog trainers, my passion blossomed from one dog. Zuka was my first hunting buddy. I took her
          everywhere; I’ve been from South Dakota down to Texas with her at my side. I’m so grateful to have the chance
          to help other people experience a new side to dog ownership.
        </p>
        <p>
          For my dog training background, I can thank Dem Feuerhaus Gun Dogs for what I know today. I worked down in
          Texas and did nothing but dog training and tacos. I have nothing but fond memories of the dogs and the people
          I met along the way. Now I have the opportunity to start my own operation in Michigan.
        </p>
        <p>I’m always down to talk hunting, dog training, or a mix of both.</p>
      </section>
    </div>
  </div>

  <section class="section band-dark" aria-labelledby="philosophy-title">
    <div class="container stack">
      <div class="head">
        <Eyebrow>Training philosophy</Eyebrow>
        <h2 id="philosophy-title">How I train</h2>
      </div>
      <ul class="principles">
        {
          principles.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CTABand title="Want to see if we’re a good fit?" tone="walnut" showCall={false}>
    The first call is free, and there’s no obligation. Tell me about your dog and we’ll go from there.
  </CTABand>
</BaseLayout>

<style>
  .intro-wrap {
    padding-top: 48px;
    padding-bottom: 56px;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .intro h1 {
    font-size: 42px;
    line-height: 1.04;
  }
  .lede {
    font-size: 19px;
    line-height: 1.55;
    color: var(--walnut);
  }
  .portrait {
    margin-bottom: 20px;
  }
  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 438px;
    object-fit: cover;
    object-position: 50% 40%;
    border-radius: var(--radius-card);
  }
  .story {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .principles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  .principles li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--walnut);
  }
  .principles h3 {
    font-size: 21px;
    line-height: 1.25;
  }
  .principles p {
    font-size: 16px;
  }

  @media (min-width: 768px) {
    .intro-wrap {
      padding-top: 88px;
      padding-bottom: 104px;
    }
    .intro-grid {
      grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
      grid-template-areas:
        'photo intro'
        'photo story';
      grid-template-rows: auto 1fr;
      column-gap: 72px;
      row-gap: 32px;
      align-items: start;
    }
    .portrait {
      grid-area: photo;
      margin-bottom: 0;
      aspect-ratio: 4 / 5;
    }
    .portrait :global(img) {
      height: 100%;
    }
    .intro {
      grid-area: intro;
      align-self: end;
    }
    .story {
      grid-area: story;
      gap: 18px;
    }
    .intro h1 {
      font-size: 56px;
    }
    .lede {
      font-size: 21px;
    }
    .stack {
      gap: 48px;
    }
    .head {
      max-width: 640px;
    }
    .principles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 56px;
    }
    .principles h3 {
      font-size: 24px;
    }
    .principles p {
      font-size: 17px;
    }
  }
</style>
